{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course.example/schemas/lab03-family.schema.json",
  "title": "Laboratory 03 held-out case family",
  "description": "Applies to course-owned held-out reserve families. The two course-owned development cases do not conform to this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "family_id",
    "origin",
    "cases",
    "expected_behaviors"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "family_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "origin": {
      "type": "string",
      "const": "course-reserve"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "https://course.example/schemas/lab03-case.schema.json" }
    },
    "expected_behaviors": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "expected_category", "expected_behavior"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "expected_category": {
            "type": "string",
            "enum": ["S", "I", "U", "Q", "R", "X"]
          },
          "expected_behavior": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
